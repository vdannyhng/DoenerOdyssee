    "@expo-google-fonts/abril-fatface": "^0.4.1",
    "@expo-google-fonts/bangers": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.30",
    "expo-clipboard": "~57.0.2",
